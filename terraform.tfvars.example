# Proxmox API authentication. Prefer an API token with the permissions required
# for guest and storage management; never commit real credentials.
pmx_api_url   = "https://192.0.2.11:8006/api2/json"
pmx_api_token = "root@pam!terraform=REDACTED"

dns_servers = ["198.51.100.1", "1.1.1.1"]

# File path only; never place private-key content in Terraform variables/state.
bootstrap_ssh_key_path = "C:/example/keys/proxmox_ed25519"

# Set true only for an approved maintenance window when a running CT needs
# rootfs placement correction. The helper uses graceful shutdown and no unlock.
allow_lxc_shutdown = false
